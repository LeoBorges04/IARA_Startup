# ── LLM / OpenAI ──────────────────────────────────────────────────────────────

# Opção 1: OpenAI Oficial
# API_KEY="sk-proj-..."
# OPENAI_MODEL="gpt-4o-mini"

# Opção 2: Modelo Local Qwen 2.5-Coder (Servidor da Faculdade via Ollama / vLLM)
# API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="qwen2.5-coder:7b"

# ── Banco de Dados ─────────────────────────────────────────────────────────────
# Sem MONGODB_URI o sistema opera em modo demonstração (In-Memory)
# MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/iara"

# ── Servidor ───────────────────────────────────────────────────────────────────
# PORT é injetado automaticamente pelo Render — não precisa definir em produção
# PORT=3000

# APP_ENV controla o modo de execução:
#   "development" → reload automático ativado (padrão local)
#   "production"  → reload desativado (obrigatório no Render)
# APP_ENV="production"
